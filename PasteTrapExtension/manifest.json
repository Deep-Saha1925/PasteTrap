{
  "manifest_version": 3,
  "name": "PasteTrap",
  "version": "1.1.0",
  "description": "Warns you when a webpage plants a suspicious command on your clipboard (ClickFix / paste-jacking attacks).",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "PasteTrap",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },

  "permissions": ["activeTab", "storage"],

  "background": {
    "service_worker": "src/service-worker.js",
    "scripts": ["src/service-worker.js"]
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/injected.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/analyzer.js", "src/content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "{6dbaccb3-619c-4115-8951-776ccdbafa0f}",
      "strict_min_version": "128.0"
    }
  }
}
